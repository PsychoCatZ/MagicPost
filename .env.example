BOT_TOKEN=

OWNER_TELEGRAM_ID=
TARGET_CHANNEL_ID=

APP_TIMEZONE=Asia/Krasnoyarsk
DATABASE_PATH=data/bot.db

AUTHOR_NAME=Анна

AI_PROVIDER=openai
OPENAI_API_KEY=
AI_MODEL=gpt-4o-mini

# Альтернативные провайдеры (OpenAI-совместимый API) — переключаются через
# AI_PROVIDER=deepseek / qwen. AI_MODEL при этом нужно сменить на модель
# выбранного провайдера, например deepseek-flash или qwen3.5-flash.
DEEPSEEK_API_KEY=
QWEN_API_KEY=

# Уведомление сайта о новой публикации (необязательно — если не задано, просто не вызывается)
SITE_NEWS_API_URL=
SITE_NEWS_API_KEY=
